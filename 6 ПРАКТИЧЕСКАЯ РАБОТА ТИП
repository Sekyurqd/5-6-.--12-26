Задание 1.
#include <bits/stdc++.h>
using namespace std;
int main() {
    int n, i, j;
    cin >> n;
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            if (i + j < n - 1) cout << 0;
            else if (i + j == n - 1) cout << 1;
            else cout << 2;
            if (j < n - 1) cout << ' ';
        }
        cout << '\n';
    }
}
Задание 2.
#include <bits/stdc++.h>
using namespace std;
int main() {
    int n, m, w, i, j, k, r, c, s, di, dj;
    int a[40][40] = {};
    cin >> n >> m >> w;
    for (k = 0; k < w; k++) {
        cin >> r >> c;
        a[r][c] = 1;
    }
    for (i = 1; i <= n; i++) {
        for (j = 1; j <= m; j++) {
            if (a[i][j]) { cout << '*'; continue; }
            s = 0;
            for (di = -1; di <= 1; di++)
                for (dj = -1; dj <= 1; dj++)
                    s += a[i + di][j + dj];
            cout << s;
        }
        cout << '\n';
    }
}
