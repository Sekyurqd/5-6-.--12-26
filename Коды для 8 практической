#include <iostream>
using namespace std;

long long g(long long a, long long b) {
    if (b == 0) return a;
    return g(b, a % b);
}

int main() {
    long long a, b;
    cin >> a >> b;
    cout << g(a, b) << endl;
    return 0;
}
