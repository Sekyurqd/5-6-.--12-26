#include <iostream>
using namespace std;

long long p(long long a, long long n) {
    long long r = 1;
    while (n > 0) {
        if (n % 2 == 1) r = r * a;
        a = a * a;
        n = n / 2;
    }
    return r;
}

int main() {
    long long a, n;
    cin >> a >> n;
    cout << p(a, n) << endl;
    return 0;
}
